{
  "name": "orthomorph-ai-knee-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"node server/server.js\" \"vite\"",
    "server": "node server/server.js",
    "client": "vite",
    "start": "node server/server.js",
